# ==========================================
# NEXUS ERP — Environment Variables Template
# ==========================================

# Server Environment
PORT=4000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
# DATABASE_URL is for PgBouncer / Connection Pooler (Application Runtime)
DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-name-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL is for Direct Connection (Prisma Migrations & CLI)
DIRECT_URL="postgresql://neondb_owner:npg_xxxx@ep-name.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="nexus-super-secret-jwt-key-minimum-32-characters-long"
JWT_EXPIRES_IN="24h"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Seeding Initial Admin Account
SEED_ADMIN_EMAIL="admin@nexus.com"
SEED_ADMIN_PASSWORD="Admin@123"

# Client Environment (Vite)
VITE_API_URL="http://localhost:4000/api"
