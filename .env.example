# ==========================================
# NEXUS ERP — Environment Variables Template
# ==========================================

# Server Environment
PORT=4000
NODE_ENV=development

# Database Configuration (Local PostgreSQL)
# For local development, use your local PostgreSQL instance.
# Create a database named "nexus_erp" before running migrations.
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/nexus_erp"

# For production with connection poolers (e.g. Neon), you may also set:
# DIRECT_URL="postgresql://user:password@host:5432/dbname"

# JWT Authentication
JWT_SECRET="nexus-super-secret-jwt-key-minimum-32-characters-long"
JWT_EXPIRES_IN="24h"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Seeding Initial Admin Account
SEED_ADMIN_EMAIL="admin@nexus.com"
SEED_ADMIN_PASSWORD="Admin@123"

# Client Environment (Vite)
VITE_API_URL="http://localhost:4000/api"
